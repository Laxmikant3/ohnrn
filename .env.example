# ---------------------------------------------------------------------------
# WindIQ configuration
#
# Copy this file to `.env` and adjust as needed. Every value is optional; the
# defaults below mirror the application defaults. The running service never
# silently refreshes data — ingestion is an explicit CLI step.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Market / analysis -----------------------------------------------------
MARKET_TIMEZONE=Europe/London
ANALYSIS_START=2026-01-01
ANALYSIS_END=2026-01-31

# Day-ahead procurement cutoff. This is a labelled pilot assumption, not a
# statement of the client's real trading deadline. Confirm before production.
DEFAULT_CUTOFF_TIME=11:00
DEFAULT_CUTOFF_DAYS_BEFORE=1

# MAPE is only computed where |actual| >= this threshold (MW).
MAPE_MIN_ACTUAL_MW=1.0

# --- Elexon BMRS -----------------------------------------------------------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=60
ELEXON_CONNECT_TIMEOUT_SECONDS=10
ELEXON_MAX_RETRIES=3
ELEXON_BACKOFF_BASE_SECONDS=0.8
ELEXON_MIN_INTERVAL_MS=250

# --- Cache -----------------------------------------------------------------
# CACHE_STALE_AFTER_HOURS controls the "stale" badge only; it never blocks reads.
CACHE_STALE_AFTER_HOURS=168

# --- API -------------------------------------------------------------------
# Comma-separated origins permitted to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080,http://127.0.0.1:5173
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# The refresh endpoint is disabled by default. When enabled, supply the token
# in the X-Admin-Token header; if ADMIN_TOKEN is empty no header is required.
ALLOW_REFRESH=false
ADMIN_TOKEN=

# --- Frontend (build-time) -------------------------------------------------
# Leave as /api/v1 so nginx (or the Vite dev proxy) forwards API calls.
VITE_API_BASE_URL=/api/v1

# --- Compose ports ---------------------------------------------------------
API_PORT=8000
WEB_PORT=8080
