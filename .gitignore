# --- Data cache -----------------------------------------------------------
# The verified January 2026 cache is committed intentionally so the demo runs
# offline and deterministically. Temporary files must never be committed.
backend/data/cache/*.tmp
backend/data/cache/**/*.tmp
backend/data/cache/.write-*

